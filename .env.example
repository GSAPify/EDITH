# EDITH environment — copy to .env and fill in. NEVER commit .env.
# All real secrets live in the macOS Keychain (via `keyring`) at runtime, not here.
# These are placeholders only.

# --- Bifrost (Pattern's model gateway) — needed by Brain/Router ---
BIFROST_BASE_URL=https://bifrost.example.internal/anthropic
BIFROST_API_KEY=replace-me-not-a-real-key
# Tier -> model id map. Router reads these; falls back to these defaults if unset.
# Optional tier->model overrides. Defaults live in edith/router/tiers.py::_DEFAULT_MODELS
# (haiku-4-5 / sonnet-5 / opus-5) — set these only to pin a tier to a specific model.
#BIFROST_MODEL_HAIKU=claude-haiku-4-5
#BIFROST_MODEL_SONNET=claude-sonnet-5
#BIFROST_MODEL_OPUS=claude-opus-5

# --- Memory store ---
# Directory that holds the Kuzu DB. In production this lives on a dedicated
# encrypted APFS volume (key in Keychain). For dev, a local path with 0700 perms.
EDITH_DATA_DIR=~/.edith/data
